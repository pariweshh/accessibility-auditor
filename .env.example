# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical links, Open Graph, sitemap & robots.
# In production set this to your deployed origin, e.g. https://equivance.app
# (Vercel deployments fall back to NEXT_PUBLIC_VERCEL_URL automatically.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# ── Scanning (headless browser) ───────────────────────────────
BROWSERLESS_TOKEN=

# ── AI fix suggestions ────────────────────────────────────────
OPENAI_API_KEY=

# ── Transactional email (magic links & monitor alerts) ────────
RESEND_API_KEY=
EMAIL_FROM=Equivance <noreply@equivance.app>
RESEND_FROM_EMAIL=Equivance Alerts <alerts@equivance.app>

# ── Scheduled Cron Security (Vercel Cron) ─────────────────────
CRON_SECRET=
